# PaddleOCR-VL × NVIDIA GPU sm120 (Blackwell / amd64) 环境变量
# 基于官方 PaddleOCR accelerators/nvidia-gpu-sm120 镜像

API_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-sm120-offline
VLM_BACKEND=vllm
VLM_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-sm120-offline
VLM_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
GPU_DEVICE_ID=0

# ---- 自建镜像构建参数（docker compose build 时生效）----
# pip 版本约束（产线 + VLM 镜像通用）
PADDLEOCR_VERSION=>=3.4.0,<3.5
PADDLEX_VERSION=>=3.4.0,<3.5
# true 时构建期预下模型到镜像（离线部署用）
BUILD_FOR_OFFLINE=false
