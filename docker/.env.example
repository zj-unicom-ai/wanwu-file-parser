# ===========================================
# wanwu-file-parser - Docker Compose 环境变量配置
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际环境修改配置项
# 3. 启动：
#    仅 CPU 服务：            docker compose -f docker/docker-compose.yml up -d
#    CPU + NVIDIA GPU：       docker compose -f docker/docker-compose.yml -f docker/paddleocr-cuda-amd64/compose.yml up -d
#    CPU + 昇腾 910B：        docker compose -f docker/docker-compose.yml -f docker/paddleocr-ascend910b-arm/compose.yml up -d
#    CPU + MinerU(GPU/CPU)：  docker compose -f docker/docker-compose.yml -f docker/mineru-cuda-amd64/compose.yml up -d
# 架构：CPU 服务(:8083) 与 GPU/NPU OCR 服务(:8080 产线 + :8118 VLM) 解耦部署。
# ===========================================

# ===========================================
# 部署模式
# ===========================================
# 是否复用已有万悟平台中间件 (minio-wanwu, bff-service 等)
# - true:  复用已有服务，wanwu-net 使用 external 模式（需预先存在 wanwu-net 网络）
# - false: 独立部署，需自行启动 minio（并改 USE_CUSTOM_MINIO=true + 自定义 MINIO_ADDRESS）
USE_EXISTING_WANWU=true

# ===========================================
# 版本 / 镜像 tag（镜像 tag 表示版本号）
# ===========================================
# CPU 调度服务镜像 tag（版本号）。
FILE_PARSER_IMAGE_TAG=0.1.0

# ===========================================
# CPU 调度服务 (:8083)
# ===========================================
# 宿主机发布端口（对外；带 public 后缀区分外部端口，映射到容器内 APP_PORT）
FILE_PARSER_PUBLIC_PORT=8083

# 容器内监听端口（uvicorn --port、healthcheck；一般无需改，与 config.py APP_PORT 一致）
APP_PORT=8083

# uvicorn worker 进程数（CPU 调度负载；CPU 密集后处理建议 ≤ 核数）
APP_WORKERS=1

# 模型类型: mineru 或 paddleocrvl
MODEL_TYPE=paddleocrvl

# ============================================================
# OCR 地址（统一 base + 可覆盖，按模型分组）
# ------------------------------------------------------------
# 避免 mineru / paddleocr 地址该来改去，统一到一组变量。解析优先级：
#   1. *_ADDRESS（模型专属完整地址覆盖，优先级最高）
#   2. OCR_BASE_URL（共享 host）+ 各模型 *_API_PATH 拼接
#   3. 历史默认值兜底
#
# 两个 client 端点契约不同（由各自协议决定）：
#   - MineruClient      ：直接 POST 到解析出的完整端点，不再追加路径；
#                          故 MINERU_API_ADDRESS 需含 /file_parse（完整端点）。
#   - PaddleOCRVLClient ：base 仅 host，client 自行追加 /layout-parsing、/restructure-pages；
#                          故 PADDLEOCRVL_ADDRESS 仅 host（不带路径）。
# ============================================================

# 共享 OCR host（可选；仅 host，如 http://ocr-host:8000）。
# 设置后 mineru 用它拼 MINERU_API_PATH，paddleocrvl 用它作 base。
# 两个模型不同 host/端口时留空，改用各自的 *_ADDRESS 覆盖。
# OCR_BASE_URL=

# ---------- MinerU（MODEL_TYPE=mineru 时使用）----------
# 端点路径（OCR_BASE_URL 非空时与之拼接，默认 file_parse）
MINERU_API_PATH=file_parse

# 文档解析 API 地址：完整覆盖（优先级高于 OCR_BASE_URL）。
# 需为完整端点（含 /file_parse），client 直接 POST 不再追加路径。
MINERU_API_ADDRESS=https://192.168.0.12:8003/file_parse

# ---------- PaddleOCR-VL（MODEL_TYPE=paddleocrvl 时使用）----------
# 两个子端点路径（client 在 base 上追加，默认如下）
PADDLEOCRVL_API_LAYOUT_PARSING_PATH=layout-parsing
PADDLEOCRVL_API_RESTRUCTURE_PAGES_PATH=restructure-pages

# 产线服务地址：完整覆盖（优先级高于 OCR_BASE_URL）；仅 host，client 追加 /layout-parsing、/restructure-pages
# - 同机（GPU/NPU compose 一起起）: http://paddleocr-vl-api:8080
# - 跨机: http://<gpu-ip>:8080
PADDLEOCRVL_ADDRESS=http://localhost:8080

# 旧版通用模型地址（兜底，不再是主接线地址）
# MODEL_ADDRESS=

# ===========================================
# GPU/NPU OCR 服务（仅硬件子目录 compose 使用）
# ===========================================
# GPU 设备 ID (从 0 开始，可通过 nvidia-smi 查看)
GPU_DEVICE_ID=0

# VLM 推理后端: vllm 或 fastdeploy
VLM_BACKEND=vllm

# VLM 模型名（必须与 genai 镜像实际服务的模型一致）
VLM_MODEL_NAME=PaddleOCR-VL-1.6-0.9B

# 产线服务镜像 tag 后缀
# - NVIDIA GPU: latest-nvidia-gpu-offline（非离线去 -offline）
# - 昇腾 NPU : latest-huawei-npu
# 换特定版本：latest → paddleocr<major>.<minor>，如 paddleocr3.3-nvidia-gpu-offline
API_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-offline

# VLM 推理服务镜像 tag 后缀（同上）
VLM_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-offline

# VLM 推理服务地址（GPU 内部，产线服务调 VLM；CPU 不直接用）
# VL_REC_SERVER_URL=http://paddleocr-vlm-server:8118/v1

# ===========================================
# 自建 PaddleOCR 镜像构建参数（docker compose build 时生效）
# ===========================================
# pip 版本约束（产线 + VLM 镜像通用）
PADDLEOCR_VERSION=>=3.4.0,<3.5
PADDLEX_VERSION=>=3.4.0,<3.5

# true 时构建期预下模型到镜像（离线部署用）
BUILD_FOR_OFFLINE=false

# MinerU 模型参数（MODEL_TYPE=mineru 时）
MINERU_BACKEND=hybrid-http-client
MINERU_LANG_LIST=ch

# 图片 URL 前缀（默认值；实际值由 client 从上传结果动态提取，留空则用 config 默认）
# PREFIX_IMAGE_URL=https://obs-nmhhht6.cucloud.cn/doc-rag-public/

# ===========================================
# MinIO 存储服务（用于图片上传；与万悟平台联动）
# ===========================================
# 是否使用自定义 MinIO
# - true:  自定义 MinIO，配置下面的 MINIO_ADDRESS 等，URL 直接拼 http://<address>/<bucket>/<obj>
# - false: 使用万悟平台 MinIO（经 BFF_SERVICE_MINIO 取 webBaseUrl 拼公共访问 URL，需 wanwu-net）
USE_CUSTOM_MINIO=false

# MinIO 服务地址
# - 独立部署: minio:9000
# - 复用万悟平台: minio-wanwu:9000（需 wanwu-net）
MINIO_ADDRESS=minio-wanwu:9000

# MinIO 访问密钥 / 秘密密钥
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=your_secret_key_here

# MinIO 默认存储桶
MINIO_DEFAULT_BUCKET=rag-public

# 万悟平台 BFF 网关（仅 USE_CUSTOM_MINIO=false 时需要；经它取 webBaseUrl 拼图片访问 URL）
BFF_SERVICE_MINIO=http://bff-service:6667/v1/api/deploy/info

# ===========================================
# OSS 存储（可选，替代 MinIO；OSS_TYPE=oss 时启用）
# ===========================================
OSS_TYPE=minio
# OSS_ENDPOINT=oss.example.com
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_BUCKET=doc-rag-public
# OSS_REGION=

# ===========================================
# 版本标识
# ===========================================
version=private
