# PaddleOCR-VL × NVIDIA GPU (cuda / amd64) 环境变量
# 基于官方 PaddleOCR accelerators/ 镜像；nvidia-gpu

# 产线服务镜像 tag 后缀；换版本 latest→paddleocr<major>.<minor>，非离线去 -offline
API_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-offline

# VLM 推理后端：vllm | fastdeploy
VLM_BACKEND=vllm

# VLM 推理服务镜像 tag 后缀
VLM_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-offline

# genai 镜像实际服务的模型名
VLM_MODEL_NAME=PaddleOCR-VL-1.6-0.9B

# NVIDIA GPU 卡号（从 0 开始，多卡逗号分隔）
GPU_DEVICE_ID=0

# ---- 自建镜像构建参数（docker compose build 时生效）----
# pip 版本约束（产线 + VLM 镜像通用）
PADDLEOCR_VERSION=>=3.4.0,<3.5
PADDLEX_VERSION=>=3.4.0,<3.5
# true 时构建期预下模型到镜像（离线部署用）
BUILD_FOR_OFFLINE=false
