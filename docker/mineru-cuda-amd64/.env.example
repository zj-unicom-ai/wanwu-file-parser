# ============================================================
# MinerU × NVIDIA GPU (cuda / amd64) 环境变量
# ============================================================

# --- MinerU API service image ---
# Replace with your own MinerU image. Official MinerU images can be used.
# MINERU_IMAGE=your-registry/mineru-api:latest

# --- 端口（宿主机侧映射）---
MINERU_API_PORT=8000

# --- GPU ---
# all 或具体卡数；多卡可写 1、2 等
MINERU_GPU_COUNT=all
