# ============================================================
# MinerU × NVIDIA GPU (cuda / amd64) 环境变量
# ============================================================

# --- MinerU API 服务镜像 ---
# 默认官方预置 GPU 镜像；按需替换为自建 MinerU 镜像
MINERU_IMAGE=crpi-6pj79y7ddzdpexs8.cn-hangzhou.personal.cr.aliyuncs.com/wanwulite/doc_parser_server:1.4.0-20260716-amd64-mineru-gpu

# --- 端口（宿主机侧映射）---
MINERU_API_PORT=8000

# --- GPU ---
# all 或具体卡数；多卡可写 1、2 等
MINERU_GPU_COUNT=all
