# PaddleOCR-VL × 摩曦 MetaX GPU (amd64) 环境变量
# 基于官方 PaddleOCR accelerators/metax-gpu 镜像
# 前置：宿主机已安装 MetaX 驱动
# 注意：摩曦官方默认 VLM 后端为 fastdeploy（非 vllm）

API_IMAGE_TAG_SUFFIX=latest-metax-gpu-offline
VLM_BACKEND=fastdeploy
VLM_IMAGE_TAG_SUFFIX=latest-metax-gpu-offline
VLM_MODEL_NAME=PaddleOCR-VL-1.6-0.9B

# ---- 自建镜像构建参数（docker compose build 时生效）----
# pip 版本约束（产线 + VLM 镜像通用）
PADDLEOCR_VERSION=>=3.4.0,<3.5
PADDLEX_VERSION=>=3.4.0,<3.5
# true 时构建期预下模型到镜像（离线部署用）
BUILD_FOR_OFFLINE=false
