# ============================================================
# MinerU × 华为昇腾 910B (Ascend NPU / arm64) 环境变量
# 前置：宿主机已安装昇腾驱动+固件（/usr/local/Ascend/driver）
# ============================================================

# --- MinerU API 服务镜像 ---
# 默认官方预置 NPU 镜像；按需替换为自建 MinerU 镜像
MINERU_IMAGE=crpi-6pj79y7ddzdpexs8.cn-hangzhou.personal.cr.aliyuncs.com/wanwulite/doc_parser_server:1.4.0-20260716-arm64-mineru-npu

# --- 端口（宿主机侧映射）---
MINERU_API_PORT=8000
