# ============================================================
# wanwu-file-parser 环境变量（FastAPI / MIT 重写）
# 对照 AGENTS.md「改造技术方案」：CPU 调度服务(:8083) 与 GPU/NPU OCR 服务 解耦。
# CPU 镜像永不 import paddleocr/paddlepaddle；OCR 全部走 HTTP。
# ============================================================

# ---- 服务 ----
APP_HOST=0.0.0.0
APP_PORT=8083
MODEL_TYPE=mineru            # mineru | paddleocrvl
VERSION=private

# ---- OCR 统一地址（推荐：两模型共享 host 时只设这个 + 各自 *_PATH） ----
# 仅 host（如 http://gpu-host:8000）。非空时 mineru 拼 MINERU_API_PATH，
# paddleocrvl 作 base 追加两个 PADDLEOCRVL_API_*_PATH。两模型不同 host 时留空，用各自 *_ADDRESS。
OCR_BASE_URL=

# ---- PaddleOCR-VL（HTTP 两段式 base64：/layout-parsing + /restructure-pages） ----
PADDLEOCRVL_ADDRESS=http://localhost:8080          # 仅 host，client 追加子端点路径
PADDLEOCRVL_API_LAYOUT_PARSING_PATH=layout-parsing
PADDLEOCRVL_API_RESTRUCTURE_PAGES_PATH=restructure-pages
VL_REC_API_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
VL_REC_API_KEY=

# ---- MinerU（HTTP multipart /file_parse，完整端点，client 直接 POST 不追加路径） ----
MINERU_API_ADDRESS=https://192.168.0.12:8003/file_parse
MINERU_API_PATH=file_parse
MINERU_API_KEY=
MINERU_BACKEND=hybrid-http-client
MINERU_LANG_LIST=ch
MINERU_MODEL_NAME=MinerU
MINERU_SERVER_URL=
MINERU_EFFORT=                # 空=用入参; true/1/high→high; false/0/medium→medium
MINERU_PARSE_METHOD=auto

# ---- 文件转换（Office → PDF，Stirling 服务） ----
STIRLING_ADDRESS=http://localhost:8080/api/v1/convert/file/pdf

# ---- 图片 URL 前缀（无图片上传时的默认值；实际值由 client 从上传结果动态提取） ----
PREFIX_IMAGE_URL=https://obs-nmhhht6.cucloud.cn/doc-rag-public/

# ---- 对象存储 ----
OSS_TYPE=minio                # minio | oss
# MinIO
USE_CUSTOM_MINIO=false
MINIO_DEFAULT_BUCKET=rag-public
BFF_SERVICE_MINIO=http://bff-service:6667/v1/api/deploy/info
MINIO_ADDRESS=minio-wanwu:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=your_sk
# OSS（OSS_TYPE=oss 时使用）
OSS_ENDPOINT=oss.example.com
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=doc-rag-public
OSS_REGION=
