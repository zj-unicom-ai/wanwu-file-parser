# ============================================================
# wanwu-file-parser - Local Development Environment
# ============================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# All settings below are OPTIONAL — sensible defaults are built
# into app/config.py. Override only what you need.
# ============================================================

# ---- Service ----
# APP_HOST=0.0.0.0
# APP_PORT=8083
# APP_WORKERS=1
# MODEL_TYPE=mineru          # mineru | paddleocrvl
# VERSION=private

# ---- OCR Unified Addressing ----
# Shared host (optional; host only, e.g. http://ocr-host:8000)
# OCR_BASE_URL=
# MINERU_API_PATH=file_parse
# PADDLEOCRVL_API_LAYOUT_PARSING_PATH=layout-parsing
# PADDLEOCRVL_API_RESTRUCTURE_PAGES_PATH=restructure-pages

# ---- PaddleOCR-VL ----
# PADDLEOCRVL_ADDRESS=http://localhost:8080

# ---- MinerU ----
# MINERU_API_ADDRESS=http://localhost:8003/file_parse
# MINERU_API_KEY=
# MINERU_BACKEND=hybrid-http-client
# MINERU_LANG_LIST=ch
# MINERU_SERVER_URL=
# MINERU_EFFORT=
# MINERU_PARSE_METHOD=auto

# ---- Image URL Prefix ----
# PREFIX_IMAGE_URL=http://localhost:8081/doc-rag-public/

# ---- Object Storage ----
# OSS_TYPE=minio              # minio | oss

# MinIO
# MINIO_ADDRESS=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_DEFAULT_BUCKET=rag-public
# MINIO_DOWNLOAD_URL=http://localhost:8081/minio/download/api

# OSS (alternative to MinIO)
# OSS_ENDPOINT=oss.example.com
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_BUCKET=doc-rag-public
# OSS_REGION=
